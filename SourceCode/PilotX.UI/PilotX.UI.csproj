<Project Sdk="Microsoft.NET.Sdk">

  <!--
    PilotX.UI — UI compartida de PilotX (Avalonia), portable entre plataformas.

    Es el resultado de L1 del port Android (ver COORDINACION-SESIONES.md): toda
    la UI nativa (App, MainWindow, Views, Services, mapa GL) vive acá como
    LIBRARY net9.0 PURO (sin `-windows`), sin ninguna dependencia de plataforma.
    Cada "head" la referencia y aporta lo específico:
      · PilotX.Desktop      (net9.0-windows, WinExe)      — WebView.Avalonia + Program.cs
      · PilotX.Android.App  (net9.0-android)  [Santiago]  — WebView nativo Android

    El único punto no portable (el WebView) está abstraído tras
    Services/IWebViewHost.cs — la UI acá NO referencia ningún paquete WebView.

    Namespace: se mantiene `PilotX.Desktop.*` (el rename masivo está diferido
    hasta después de la migración, ver memoria project_android_port_deferred).
    Por eso AssemblyName = PilotX.UI pero RootNamespace = PilotX.Desktop.
  -->

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <RootNamespace>PilotX.Desktop</RootNamespace>
    <AssemblyName>PilotX.UI</AssemblyName>
    <NoWarn>$(NoWarn);CS8618;CS8600;CS8601;CS8602;IDE0055</NoWarn>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <!-- AllowUnsafeBlocks: para los pointer ops de Silk.NET.OpenGL en
         Views/MapGlSurface (BufferData/UniformMatrix4 toman void*). -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <!-- Solo Avalonia CORE + temas + fuentes. La plataforma (Avalonia.Desktop /
         Avalonia.Android) la aporta cada head. NADA de WebView acá. -->
    <PackageReference Include="Avalonia" Version="11.2.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.2.3" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.2.3" />

    <!-- CommunityToolkit.Mvvm: source generators, sin reflexión en runtime. -->
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />

    <!-- Silk.NET.OpenGL: bindings GL para Views/MapGlSurface (GL ES vía el
         GlInterface que expone OpenGlControlBase; mismos shaders #version 300 es
         corren en ANGLE/Windows y GL ES/Android). -->
    <PackageReference Include="Silk.NET.OpenGL" Version="2.21.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Barras del cockpit (menús superior/derecha/abajo/izquierda). -->
    <ProjectReference Include="..\PilotX.Cockpit.Bars\PilotX.Cockpit.Bars.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      AgpErrorMapper ENLAZADO, no por referencia de proyecto.

      El mapeo excepción → código AGP-* tiene que ser el MISMO en todos lados:
      si el shell inventara sus propios códigos, el número que el operario nos
      pasa por teléfono no significaría lo mismo según de dónde salió.

      Pero AgroParallel.Services arrastra MQTTnet, NetTopologySuite y
      System.Text.Json, y no tiene sentido cargarle todo eso al shell por un
      archivo que solo usa System. Enlazar el .cs deja una sola fuente de
      verdad sin las dependencias.
    -->
    <Compile Include="..\AgroParallel\Core\AgroParallel.Services\AgpErrorMapper.cs"
             Link="Servicios\AgpErrorMapper.cs" />
  </ItemGroup>

</Project>
