<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="PilotX.Desktop.Views.CoreXEcuPanel">
    <!--
        CoreXEcuPanel - reemplazo nativo (Live tab only) de pages/corex-ecu.html.

        Tarjeta FLOTANTE sobre el mapa vivo (mismo patron que GuiasPanel /
        LotePanel): el mapa nunca se apaga, el panel es una card clara
        compacta. Antes era un takeover pantalla completa oscuro y en cabina
        se veia como "una ventana gigante negra" (reporte 2026-08-07).

        Polling 2Hz contra /api/corex-ecu/status mientras esta abierto.
        Cards: IMU, WAS, GPS, CAN Keya, Autosteer, Sistema.

        Las otras tabs (Estado / checklist, Calibracion / motor manual +
        barrido PWM Keya, Conexion / config con Teensy) NO estan portadas:
        el boton "Configurar" abre el WebView lazy sobre pages/corex-ecu.html —
        son flujos que se hacen parados en el galpon, no en cabina.

        Importante: NO se toca el firmware Teensy. Esto es solo la UI que lo
        observa via el Hub local.
    -->
    <Border Background="#FAFBFA"
            BorderBrush="#C5CFC5"
            BorderThickness="1"
            CornerRadius="14"
            Padding="14"
            BoxShadow="0 8 26 0 #33101612"
            Width="860" MaxHeight="620"
            HorizontalAlignment="Center" VerticalAlignment="Center">
        <DockPanel>

            <!-- ============ Header ============ -->
            <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto,Auto,Auto"
                  Margin="4,0,0,10">
                <StackPanel Grid.Column="0" Spacing="1" VerticalAlignment="Center">
                    <TextBlock Text="CoreX-ECU"
                               Foreground="#101612"
                               FontSize="16" FontWeight="Bold"/>
                    <TextBlock Name="SubtitleText"
                               Text="Telemetria del autosteer"
                               Foreground="#535E54"
                               FontSize="11"/>
                </StackPanel>

                <!-- Pill: conexion con el ECU -->
                <Border Grid.Column="1"
                        Background="#FFFFFF"
                        BorderBrush="#C5CFC5"
                        BorderThickness="1"
                        CornerRadius="999"
                        Padding="12,5,12,5"
                        Margin="0,0,8,0"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                        <Ellipse Name="EcuDot"
                                 Width="10" Height="10"
                                 Fill="#8A958B"
                                 VerticalAlignment="Center"/>
                        <TextBlock Name="EcuText"
                                   Text="sin datos"
                                   Foreground="#535E54"
                                   FontSize="12"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <Button Grid.Column="2"
                        Name="BtnConfigurar"
                        Content="Configurar"
                        Click="OnConfigurarClick"
                        Background="#FFFFFF"
                        Foreground="#101612"
                        BorderBrush="#C5CFC5"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="14,7,14,7"
                        Margin="0,0,8,0"
                        VerticalAlignment="Center"
                        ToolTip.Tip="Abre Estado / Calibracion / Conexion en el Hub"/>

                <Button Grid.Column="3"
                        Name="BtnCerrar"
                        Content="✕"
                        Click="OnCerrarClick"
                        Width="40" Height="40"
                        FontSize="16"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"
                        Background="#FFFFFF"
                        Foreground="#535E54"
                        BorderBrush="#C5CFC5"
                        BorderThickness="1"
                        CornerRadius="8"
                        VerticalAlignment="Center"/>
            </Grid>

            <!-- ============ Error chip (oculto si ok) ============ -->
            <Border DockPanel.Dock="Top"
                    Name="ErrorChip"
                    Background="#FBECEC"
                    BorderBrush="#D0504A"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="12,8,12,8"
                    Margin="0,0,0,10"
                    IsVisible="False">
                <StackPanel Spacing="2">
                    <TextBlock Name="ErrorCode"
                               Foreground="#B33F3A"
                               FontSize="11"
                               FontWeight="SemiBold"
                               FontFamily="Consolas, Courier New, monospace"/>
                    <TextBlock Name="ErrorMsg"
                               Foreground="#101612"
                               FontSize="13"
                               TextWrapping="Wrap"/>
                    <TextBlock Name="ErrorTech"
                               Foreground="#535E54"
                               FontSize="10"
                               TextWrapping="Wrap"
                               FontFamily="Consolas, Courier New, monospace"/>
                </StackPanel>
            </Border>

            <!-- ============ Grid de 6 cards ============ -->
            <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto">
                <UniformGrid Name="CardsHost" Columns="3"/>
            </ScrollViewer>
        </DockPanel>
    </Border>
</UserControl>
