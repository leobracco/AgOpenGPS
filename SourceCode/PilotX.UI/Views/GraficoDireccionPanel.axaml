<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:PilotX.Desktop.Views"
             x:Class="PilotX.Desktop.Views.GraficoDireccionPanel">
    <!--
        GraficoDireccionPanel - reemplazo nativo de pages/grafico-direccion.html
        (ex ventana WinForms FormGraphSteer).

        Mismo contrato REST que la página: GET /api/aog/graph-steer devuelve
        { actual_steer_deg, set_steer_deg } en snake_case y esto solo lo
        grafica. Muestreo a 5 Hz, buffer rodante de 120 muestras, eje simétrico
        ±escala. Los tres botones de escala son 100% del lado cliente, igual que
        en el JS: no tocan nada en PilotX.

        La página HTML queda intacta para el celular/PWA.

        PALETA: la página era "dark cockpit"; acá va la paleta CLARA de panel
        (tokens PilotXPanel*), como el resto de las pantallas nativas. Los
        COLORES DE SERIE sí se conservan tal cual (el color de la traza es
        información que el operario ya tiene aprendida): verde de marca para la
        dirección real, #3D87C6 para la seteada. Los NÚMEROS grandes van con la
        variante legible sobre fondo claro (ver el comentario del theme).
    -->
    <ThemeVariantScope RequestedThemeVariant="Light">
        <!-- Name="Card": ModoEmbebido() le suelta el marco/tamaño; la instancia
             flotante no cambia. -->
        <Border Name="Card"
                Background="{StaticResource PilotXPanelCard}"
                BorderBrush="{StaticResource PilotXPanelBorderHigh}"
                BorderThickness="1"
                CornerRadius="14"
                ClipToBounds="True"
                BoxShadow="0 8 26 0 #33101612"
                MaxWidth="720" MaxHeight="560"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                Margin="16,8">

            <!-- Fila * = el área de dibujo se come el alto que sobra, igual que
                 el canvas de 52vh de la página. -->
            <Grid Name="ContenidoRaiz" Margin="24,20,24,24"
                  RowDefinitions="Auto,Auto,*,Auto,Auto">

                <!-- ============ Header (.page-head) ============ -->
                <!-- Name="DragHandle": de acá se agarra para CORRER la card
                     sobre el mapa (PanelArrastrable). Doble toque = centro. -->
                <Grid Grid.Row="0" Name="DragHandle" Background="Transparent"
                      ColumnDefinitions="*,Auto,Auto" Margin="0,0,0,16">
                    <StackPanel Grid.Column="0" Name="HeaderTitulo" Spacing="2">
                        <TextBlock Text="Gráfico de dirección"
                                   Foreground="{StaticResource PilotXPanelText}"
                                   FontSize="22" FontWeight="SemiBold"/>
                        <TextBlock Text="Ángulo de dirección real vs seteado · solo lectura"
                                   Foreground="{StaticResource PilotXPanelTextDim}"
                                   FontSize="12"/>
                    </StackPanel>

                    <!-- .pill.idle: en la página la clase NUNCA cambia, solo el
                         texto ("—" / "en vivo" / "sin conexión"). Se replica:
                         el punto queda siempre gris. -->
                    <Border Grid.Column="1" Name="HeaderPill"
                            Background="{StaticResource PilotXPanelSurface2}"
                            BorderBrush="{StaticResource PilotXPanelBorderHigh}"
                            BorderThickness="1"
                            CornerRadius="999"
                            Padding="14,6,14,6"
                            Margin="0,0,8,0"
                            VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Ellipse Width="8" Height="8"
                                     Fill="{StaticResource PilotXPanelIdle}"
                                     VerticalAlignment="Center"/>
                            <TextBlock Name="StatusText" Text="—"
                                       Foreground="{StaticResource PilotXPanelTextDim}"
                                       FontSize="13"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <Button Grid.Column="2" Name="BtnCerrar" Content="✕"
                            Click="OnCerrarClick"
                            ToolTip.Tip="Cerrar"
                            Background="{StaticResource PilotXPanelSurface2}"
                            Foreground="{StaticResource PilotXPanelText}"
                            BorderBrush="{StaticResource PilotXPanelBorderHigh}"
                            BorderThickness="1"
                            CornerRadius="8" Width="48" Height="48"
                            FontSize="15"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"
                            VerticalAlignment="Center"/>
                </Grid>

                <!-- ============ Lecturas (.g-readouts) ============ -->
                <Grid Grid.Row="1" ColumnDefinitions="Auto,Auto,*" Margin="0,0,0,16">
                    <Border Grid.Column="0"
                            Background="{StaticResource PilotXPanelSurface}"
                            BorderBrush="{StaticResource PilotXPanelBorderHigh}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="12,9,20,9"
                            MinWidth="160"
                            Margin="0,0,24,0">
                        <StackPanel Spacing="2">
                            <TextBlock Text="Dirección real (WAS)"
                                       Foreground="{StaticResource PilotXPanelTextDim}"
                                       FontSize="12"/>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Name="ValAct" Text="0.0"
                                           Foreground="{StaticResource PilotXPanelAccentText}"
                                           FontFamily="Consolas, Courier New, monospace"
                                           FontSize="38" FontWeight="Bold" LineHeight="42"/>
                                <TextBlock Text="°"
                                           Foreground="{StaticResource PilotXPanelAccentText}"
                                           FontFamily="Consolas, Courier New, monospace"
                                           FontSize="38" FontWeight="Bold" LineHeight="42"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1"
                            Background="{StaticResource PilotXPanelSurface}"
                            BorderBrush="{StaticResource PilotXPanelBorderHigh}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="12,9,20,9"
                            MinWidth="160">
                        <StackPanel Spacing="2">
                            <TextBlock Text="Dirección seteada"
                                       Foreground="{StaticResource PilotXPanelTextDim}"
                                       FontSize="12"/>
                            <StackPanel Orientation="Horizontal">
                                <!-- #2F6E9E: variante legible sobre blanco del
                                     azul de serie #3D87C6 (no hay token azul
                                     en el theme). -->
                                <TextBlock Name="ValSet" Text="0.0"
                                           Foreground="#2F6E9E"
                                           FontFamily="Consolas, Courier New, monospace"
                                           FontSize="38" FontWeight="Bold" LineHeight="42"/>
                                <TextBlock Text="°"
                                           Foreground="#2F6E9E"
                                           FontFamily="Consolas, Courier New, monospace"
                                           FontSize="38" FontWeight="Bold" LineHeight="42"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- ============ Área de dibujo (.g-chart-wrap) ============ -->
                <Border Grid.Row="2"
                        Background="{StaticResource PilotXPanelSurface}"
                        BorderBrush="{StaticResource PilotXPanelBorderHigh}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="12"
                        MinHeight="200">
                    <Grid>
                        <v:GraficoLineal Name="Lienzo"/>
                        <TextBlock Name="AxisMax" Text="40"
                                   Foreground="{StaticResource PilotXPanelTextDim}"
                                   FontFamily="Consolas, Courier New, monospace"
                                   FontSize="11"
                                   HorizontalAlignment="Right" VerticalAlignment="Top"
                                   Margin="0,0,4,0"/>
                        <TextBlock Name="AxisMin" Text="-40"
                                   Foreground="{StaticResource PilotXPanelTextDim}"
                                   FontFamily="Consolas, Courier New, monospace"
                                   FontSize="11"
                                   HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                   Margin="0,0,4,0"/>
                    </Grid>
                </Border>

                <!-- ============ Leyenda (.g-legend) ============ -->
                <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="20" Margin="0,12,0,0">
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <Border Width="14" Height="3" CornerRadius="2"
                                Background="{StaticResource PilotXPanelAccent}"
                                VerticalAlignment="Center"/>
                        <TextBlock Text="Dirección real (°)"
                                   Foreground="{StaticResource PilotXPanelTextMid}"
                                   FontSize="12" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <Border Width="14" Height="3" CornerRadius="2"
                                Background="#3D87C6"
                                VerticalAlignment="Center"/>
                        <TextBlock Text="Dirección seteada (°)"
                                   Foreground="{StaticResource PilotXPanelTextMid}"
                                   FontSize="12" VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>

                <!-- ============ Controles de escala (.g-controls) ============ -->
                <StackPanel Grid.Row="4" Name="FilaControles"
                            Orientation="Horizontal" Spacing="8" Margin="0,16,0,0">
                    <Button Name="BtnGainDown" Content="− Escala" Click="OnEscalaMenosClick"
                            Background="{StaticResource PilotXPanelSurface2}"
                            Foreground="{StaticResource PilotXPanelText}"
                            BorderBrush="{StaticResource PilotXPanelBorderHigh}"
                            BorderThickness="1" CornerRadius="8"
                            Padding="16,0" MinHeight="40" FontSize="14"
                            HorizontalContentAlignment="Center"
                            ToolTip.Tip="Achica el eje: la traza se ve más grande"/>
                    <Button Name="BtnGainAuto" Content="Auto" Click="OnAutoClick"
                            Background="{StaticResource PilotXPanelSurface2}"
                            Foreground="{StaticResource PilotXPanelText}"
                            BorderBrush="{StaticResource PilotXPanelBorderHigh}"
                            BorderThickness="1" CornerRadius="8"
                            Padding="16,0" MinHeight="40" FontSize="14"
                            HorizontalContentAlignment="Center"
                            ToolTip.Tip="Ajusta el eje a los datos"/>
                    <Button Name="BtnGainUp" Content="+ Escala" Click="OnEscalaMasClick"
                            Background="{StaticResource PilotXPanelSurface2}"
                            Foreground="{StaticResource PilotXPanelText}"
                            BorderBrush="{StaticResource PilotXPanelBorderHigh}"
                            BorderThickness="1" CornerRadius="8"
                            Padding="16,0" MinHeight="40" FontSize="14"
                            HorizontalContentAlignment="Center"
                            ToolTip.Tip="Agranda el eje: entra más recorrido"/>
                </StackPanel>

            </Grid>
        </Border>
    </ThemeVariantScope>
</UserControl>
