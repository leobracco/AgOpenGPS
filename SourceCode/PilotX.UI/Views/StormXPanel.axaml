<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="PilotX.Desktop.Views.StormXPanel">
    <!--
        StormXPanel - reemplazo nativo de pages/stormx.html.

        Lee del /api/stormx/live cada 1s (mismo cadence que el stormx.js
        original) y pinta:
          - Pill de estado global (Pulverizar OK / NO PULVERIZAR / sin datos)
          - 4 KPIs: Viento + dir, Temperatura + Delta-T, Humedad + Presion,
            Veredicto + edad de la lectura
          - Umbrales operativos en uso (eco del config, read-only)
          - Lista de nodos StormX detectados
    -->
    <!--
        Card clara flotante con el mapa VIVO detras (misma receta que
        ConfigPanel / Hub): antes este panel se pintaba a pantalla completa
        con la paleta oscura y el mapa apagado — "una ventana negra gigante"
        (reporte 2026-08-16). El mapa nunca se apaga ni se tapa del todo.
    -->
    <ThemeVariantScope RequestedThemeVariant="Light">
        <!-- Name="Card": ModoEmbebido() (adentro de la Configuración) le
             suelta el marco/tamaño; la instancia flotante no cambia. -->
        <Border Name="Card"
                Background="{StaticResource PilotXPanelCard}"
                BorderBrush="{StaticResource PilotXPanelBorderHigh}"
                BorderThickness="1"
                CornerRadius="14"
                ClipToBounds="True"
                BoxShadow="0 8 26 0 #33101612"
                MaxWidth="940" MaxHeight="640"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                Margin="16,8">
            <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto">
                <StackPanel Name="ContenidoRaiz" Margin="24,20,24,24" Spacing="14">

                    <!-- ============ Header ============ -->
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Name="HeaderTitulo" Grid.Column="0" Spacing="2">
                            <TextBlock Text="StormX"
                                       Foreground="{StaticResource PilotXPanelText}"
                                       FontSize="22"
                                       FontWeight="SemiBold"/>
                            <TextBlock Text="Estacion meteorologica movil"
                                       Foreground="{StaticResource PilotXPanelTextDim}"
                                       FontSize="12"/>
                        </StackPanel>

                        <Border Grid.Column="1"
                                Background="{StaticResource PilotXPanelSurface2}"
                                BorderBrush="{StaticResource PilotXPanelBorderHigh}"
                                BorderThickness="1"
                                CornerRadius="999"
                                Padding="14,6,14,6"
                                VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <Ellipse Name="EstadoDot"
                                         Width="10" Height="10"
                                         Fill="{StaticResource PilotXPanelTextDim}"
                                         VerticalAlignment="Center"/>
                                <TextBlock Name="EstadoText"
                                           Text="Condiciones --"
                                           Foreground="{StaticResource PilotXPanelTextMid}"
                                           FontSize="13"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- ============ KPIs ============ -->
                    <UniformGrid Columns="2" Rows="2">
                        <Border Background="{StaticResource PilotXPanelSurface}"
                                BorderBrush="{StaticResource PilotXPanelBorderHigh}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="16,14,16,14"
                                Margin="0,0,8,8">
                            <StackPanel Spacing="6">
                                <TextBlock Text="Viento"
                                           Foreground="{StaticResource PilotXPanelTextDim}"
                                           FontSize="12"
                                           FontWeight="SemiBold"/>
                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Bottom">
                                    <TextBlock Name="KpiWind" Text="--"
                                               Foreground="{StaticResource PilotXPanelText}"
                                               FontSize="36" FontWeight="Bold"/>
                                    <TextBlock Text="m/s"
                                               Foreground="{StaticResource PilotXPanelTextDim}"
                                               FontSize="14" Margin="0,0,0,8"/>
                                </StackPanel>
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Grid.Column="0" Text="Direccion"
                                               Foreground="{StaticResource PilotXPanelTextDim}" FontSize="11"/>
                                    <TextBlock Grid.Column="1" Name="KpiDir" Text="-- °"
                                               Foreground="{StaticResource PilotXPanelText}" FontSize="12"
                                               FontWeight="SemiBold"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Background="{StaticResource PilotXPanelSurface}"
                                BorderBrush="{StaticResource PilotXPanelBorderHigh}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="16,14,16,14"
                                Margin="8,0,0,8">
                            <StackPanel Spacing="6">
                                <TextBlock Text="Temperatura"
                                           Foreground="{StaticResource PilotXPanelTextDim}"
                                           FontSize="12" FontWeight="SemiBold"/>
                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Bottom">
                                    <TextBlock Name="KpiTemp" Text="--"
                                               Foreground="{StaticResource PilotXPanelText}"
                                               FontSize="36" FontWeight="Bold"/>
                                    <TextBlock Text="°C"
                                               Foreground="{StaticResource PilotXPanelTextDim}"
                                               FontSize="14" Margin="0,0,0,8"/>
                                </StackPanel>
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Grid.Column="0" Text="Delta-T"
                                               Foreground="{StaticResource PilotXPanelTextDim}" FontSize="11"/>
                                    <TextBlock Grid.Column="1" Name="KpiDeltaT" Text="-- °C"
                                               Foreground="{StaticResource PilotXPanelText}" FontSize="12"
                                               FontWeight="SemiBold"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Background="{StaticResource PilotXPanelSurface}"
                                BorderBrush="{StaticResource PilotXPanelBorderHigh}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="16,14,16,14"
                                Margin="0,8,8,0">
                            <StackPanel Spacing="6">
                                <TextBlock Text="Humedad"
                                           Foreground="{StaticResource PilotXPanelTextDim}"
                                           FontSize="12" FontWeight="SemiBold"/>
                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Bottom">
                                    <TextBlock Name="KpiHum" Text="--"
                                               Foreground="{StaticResource PilotXPanelText}"
                                               FontSize="36" FontWeight="Bold"/>
                                    <TextBlock Text="%"
                                               Foreground="{StaticResource PilotXPanelTextDim}"
                                               FontSize="14" Margin="0,0,0,8"/>
                                </StackPanel>
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Grid.Column="0" Text="Presion"
                                               Foreground="{StaticResource PilotXPanelTextDim}" FontSize="11"/>
                                    <TextBlock Grid.Column="1" Name="KpiPress" Text="-- hPa"
                                               Foreground="{StaticResource PilotXPanelText}" FontSize="12"
                                               FontWeight="SemiBold"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Background="{StaticResource PilotXPanelSurface}"
                                BorderBrush="{StaticResource PilotXPanelBorderHigh}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="16,14,16,14"
                                Margin="8,8,0,0">
                            <StackPanel Spacing="6">
                                <TextBlock Text="Pulverizacion"
                                           Foreground="{StaticResource PilotXPanelTextDim}"
                                           FontSize="12" FontWeight="SemiBold"/>
                                <TextBlock Name="KpiAdvice" Text="--"
                                           Foreground="{StaticResource PilotXPanelText}"
                                           FontSize="18" FontWeight="SemiBold"
                                           TextWrapping="Wrap"/>
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Grid.Column="0" Text="Ultima lectura"
                                               Foreground="{StaticResource PilotXPanelTextDim}" FontSize="11"/>
                                    <TextBlock Grid.Column="1" Name="KpiAge" Text="--"
                                               Foreground="{StaticResource PilotXPanelText}" FontSize="12"
                                               FontWeight="SemiBold"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <!-- ============ Umbrales operativos ============ -->
                    <TextBlock Text="Umbrales operativos"
                               Foreground="{StaticResource PilotXPanelText}"
                               FontSize="16" FontWeight="SemiBold"
                               Margin="0,4,0,0"/>
                    <Border Background="{StaticResource PilotXPanelSurface}"
                            BorderBrush="{StaticResource PilotXPanelBorderHigh}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="18,14,18,16">
                        <StackPanel Spacing="10">
                            <TextBlock Text="El sistema activa una alerta cuando viento, humedad o Delta-T salen de rango para pulverizar."
                                       Foreground="{StaticResource PilotXPanelTextDim}"
                                       FontSize="12"
                                       TextWrapping="Wrap"/>
                            <UniformGrid Columns="5" Rows="1">
                                <StackPanel Spacing="2" Margin="0,0,8,0">
                                    <TextBlock Text="Viento max."
                                               Foreground="{StaticResource PilotXPanelText}"
                                               FontSize="13" FontWeight="SemiBold"/>
                                    <TextBlock Name="LimWindMax" Text="--"
                                               Foreground="{StaticResource PilotXPanelTextDim}" FontSize="12"/>
                                </StackPanel>
                                <StackPanel Spacing="2" Margin="0,0,8,0">
                                    <TextBlock Text="Viento min."
                                               Foreground="{StaticResource PilotXPanelText}"
                                               FontSize="13" FontWeight="SemiBold"/>
                                    <TextBlock Name="LimWindMin" Text="--"
                                               Foreground="{StaticResource PilotXPanelTextDim}" FontSize="12"/>
                                </StackPanel>
                                <StackPanel Spacing="2" Margin="0,0,8,0">
                                    <TextBlock Text="Humedad min."
                                               Foreground="{StaticResource PilotXPanelText}"
                                               FontSize="13" FontWeight="SemiBold"/>
                                    <TextBlock Name="LimHumMin" Text="--"
                                               Foreground="{StaticResource PilotXPanelTextDim}" FontSize="12"/>
                                </StackPanel>
                                <StackPanel Spacing="2" Margin="0,0,8,0">
                                    <TextBlock Text="Temp. max."
                                               Foreground="{StaticResource PilotXPanelText}"
                                               FontSize="13" FontWeight="SemiBold"/>
                                    <TextBlock Name="LimTempMax" Text="--"
                                               Foreground="{StaticResource PilotXPanelTextDim}" FontSize="12"/>
                                </StackPanel>
                                <StackPanel Spacing="2">
                                    <TextBlock Text="Delta-T max."
                                               Foreground="{StaticResource PilotXPanelText}"
                                               FontSize="13" FontWeight="SemiBold"/>
                                    <TextBlock Name="LimDeltaTMax" Text="--"
                                               Foreground="{StaticResource PilotXPanelTextDim}" FontSize="12"/>
                                </StackPanel>
                            </UniformGrid>
                        </StackPanel>
                    </Border>

                    <!-- ============ Nodos ============ -->
                    <TextBlock Text="Nodos StormX"
                               Foreground="{StaticResource PilotXPanelText}"
                               FontSize="16" FontWeight="SemiBold"
                               Margin="0,4,0,0"/>
                    <Border Background="{StaticResource PilotXPanelSurface}"
                            BorderBrush="{StaticResource PilotXPanelBorderHigh}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="18,14,18,16">
                        <StackPanel Name="NodosList" Spacing="8">
                            <TextBlock Name="NodosEmpty"
                                       Text="Buscando nodos en LAN... La estacion StormX publica telemetria en agp/storm/{uid}/status_live al broker MQTT del PC."
                                       Foreground="{StaticResource PilotXPanelTextDim}"
                                       FontSize="12"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>
        </Border>
    </ThemeVariantScope>
</UserControl>
