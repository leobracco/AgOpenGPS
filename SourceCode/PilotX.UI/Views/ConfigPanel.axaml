<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="PilotX.Desktop.Views.ConfigPanel">
    <!--
        ConfigPanel — SHELL nativo de la Configuración del vehículo/implemento
        (el porteo de pages/config.html: tabs de navegación + pestañas + footer).

        QUÉ QUEDÓ NATIVO: el contenedor (navegación por grupos en DOS FILAS de
        tabs horizontales — grupos arriba, entradas del grupo activo en la
        barra de contexto —, footer con perfil/ancho/unidades, mensajes de
        estado, botón Guardar), las 16 pestañas de config y los MÓDULOS como
        entradas directas de los grupos (Módulos/Campo/Herramientas/Cloud/
        Mantenimiento + Sonidos en Otros, mismo orden que el #menu de
        config.html — sin grilla intermedia). Los módulos con pantalla propia (Hub, QuantiX, VistaX,
        FlowX, SectionX, StormX, CoreX-ECU, Nodos, Cámaras, Prescripciones,
        Actualizar, Sistema, Sonidos) se montan como INSTANCIA PROPIA en
        ModuloNativoHost, adentro de esta misma tarjeta.
        QUÉ SIGUE EN HTML: los módulos sin panel nativo (LineX, Insumos,
        Mapas, Calculadora, Lab PID, Diagnóstico PWM, OrbitX, Firmwares,
        Conectar celular, Red WiFi, Eventos, Debug, Ayuda). Se abren EMBEBIDOS
        acá adentro (HtmlHost), así que el operario llega a todo desde el
        mismo lugar de siempre. La página config.html NO se toca ni se borra:
        la usa la PWA del celular (strangler fig).

        Card clara flotante con el mapa VIVO detrás — el mapa nunca se apaga.
        Nada de Flyout/MenuFlyout: sobre el mapa GL no se dibujan.
    -->
    <Panel>
        <!-- Name="CardShell": TAMAÑO FIJO. La card se estira al área que le da
             el host menos un margen constante (el mapa vivo se ve alrededor) y
             MaxWidth/MaxHeight solo la topean en monitores grandes (queda
             centrada). Así mide SIEMPRE lo mismo, esté el operario parado en
             Resumen, en QuantiX o en una página HTML: antes el Center + el
             MaxWidth por-módulo hacían que cada toque del menú redimensionara
             la ventana entera ("se agranda se achica, muy despelotado",
             reporte 2026-08-18). En 1024x768 da 976x740 clavados. -->
        <Border Name="CardShell"
                Background="#FAFBFA"
                BorderBrush="#C5CFC5"
                BorderThickness="1"
                CornerRadius="14"
                Padding="14"
                BoxShadow="0 8 26 0 #33101612"
                MaxWidth="1160" MaxHeight="740"
                HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                Margin="24,14">
            <DockPanel>

                <!-- ============ Header ============ -->
                <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*,Auto,Auto"
                      Margin="4,0,0,10">
                    <TextBlock Grid.Column="0" Text="Configuración"
                               Foreground="#101612"
                               FontSize="16" FontWeight="Bold"
                               VerticalAlignment="Center"/>

                    <!-- Pill: perfil de vehículo activo -->
                    <Border Grid.Column="2"
                            Background="#FFFFFF" BorderBrush="#C5CFC5" BorderThickness="1"
                            CornerRadius="999" Padding="12,5,12,5" Margin="0,0,8,0"
                            VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                            <Ellipse Name="EstadoDot" Width="9" Height="9" Fill="#8A958B"
                                     VerticalAlignment="Center"/>
                            <TextBlock Name="PerfilPillText" Text="Cargando…"
                                       Foreground="#535E54" FontSize="12"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <Button Grid.Column="3" Name="BtnCerrar" Content="✕"
                            Click="OnCerrarClick"
                            Background="#FFFFFF" Foreground="#101612"
                            BorderBrush="#C5CFC5" BorderThickness="1"
                            CornerRadius="8" Width="48" Height="48"
                            FontSize="15"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"
                            VerticalAlignment="Center"/>
                </Grid>

                <!-- ============ Footer (réplica del footer de config.html) ============ -->
                <Border DockPanel.Dock="Bottom" Background="#FFFFFF"
                        BorderBrush="#E2E7E2" BorderThickness="0,1,0,0"
                        Padding="10,8,10,8" Margin="0,10,0,0" CornerRadius="0,0,8,8">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="14"
                                    VerticalAlignment="Center">
                            <TextBlock Name="FtPerfil" Foreground="#535E54" FontSize="12"/>
                            <TextBlock Name="FtAncho" Foreground="#535E54" FontSize="12"/>
                            <TextBlock Name="FtUnidades" Foreground="#535E54" FontSize="12"/>
                        </StackPanel>
                        <TextBlock Grid.Column="1" Name="EstadoText" Text=""
                                   Foreground="#535E54" FontSize="12"
                                   TextAlignment="Right" TextWrapping="NoWrap"
                                   Margin="12,0,12,0" VerticalAlignment="Center"/>
                        <!-- Guardar: el botón que decide si el trabajo se guarda.
                             Estaba blanco sobre el verde de acento #4ABA3E, que
                             da 2,5:1 medido — con sol la palabra desaparecía
                             justo en el control más importante de la pantalla.
                             #2F7A26 da 5,3:1 y sigue siendo el verde de PilotX.
                             48 px de alto: abajo de 44 no se acierta con guante. -->
                        <Button Grid.Column="2" Name="BtnGuardar" Content="Guardar"
                                Click="OnGuardarClick" IsVisible="False"
                                Background="#2F7A26" Foreground="White"
                                BorderBrush="#2F7A26" BorderThickness="1"
                                CornerRadius="8" MinHeight="48" Padding="18,8"
                                FontSize="13" FontWeight="SemiBold"/>
                    </Grid>
                </Border>

                <!-- ============ Fila 1: TABS de grupos ============
                     Reemplazo del menú lateral en acordeón (2026-08-18): la
                     navegación va ARRIBA en dos filas — acá los grupos del NAV
                     (Resumen, Vehículo, …, Mantenimiento) y las entradas del
                     grupo activo en la barra de contexto de abajo. El
                     contenido gana los ~196 px de la columna vieja. En 976 de
                     card los 11 grupos entran enteros; si un idioma los
                     alargara, la fila panea horizontal con el dedo (barra
                     oculta, sin flechas). El activo se marca con fondo suave
                     verde + subrayado de acento, nunca verde macizo. -->
                <Border DockPanel.Dock="Top"
                        BorderBrush="#E2E7E2" BorderThickness="0,0,0,1"
                        Margin="0,0,0,8">
                    <ScrollViewer HorizontalScrollBarVisibility="Hidden"
                                  VerticalScrollBarVisibility="Disabled">
                        <StackPanel Name="GruposHost" Orientation="Horizontal" Spacing="2"/>
                    </ScrollViewer>
                </Border>

                <!-- ============ Contenido: pestaña nativa O módulo ============
                     ESQUELETO UNIFORME para todas las entradas (pestañas
                     nativas, módulos nativos embebidos y módulos HTML):
                     · BarraContexto — fija arriba, de ALTO CONSTANTE (52):
                       fusiona la FILA 2 de tabs con la vieja barra de
                       contexto. A la izquierda las entradas del grupo activo
                       (pills — la fila reserva SIEMPRE su espacio aunque el
                       grupo tenga una sola entrada, como Resumen: nada salta
                       de altura al navegar); en el medio el subtítulo
                       (SubtituloText), que solo se muestra cuando dice algo
                       DISTINTO de la entrada activa (páginas satélite tipo
                       "Nodos — Detalle del nodo"); y a la derecha las pills
                       de estado/acciones del módulo (ContextoPills — cada
                       panel embebido las entrega por PillsDeContexto()),
                       SIEMPRE en el mismo lugar;
                     · abajo, tres vistas excluyentes en el MISMO hueco y con
                       el MISMO padding: TabScroll (pestañas nativas),
                       HtmlHost (páginas del Hub por WebView) y
                       ModuloNativoHost (paneles nativos como instancia
                       propia). El scroll vive SIEMPRE acá adentro, nunca en
                       la card entera.
                     Nada abre otra ventana ni cierra esta tarjeta: antes los
                     módulos nativos saltaban a un overlay de pantalla completa
                     que escondía la Configuración (reportes 2026-08-16/17). -->
                <DockPanel>
                    <Border DockPanel.Dock="Top" Name="BarraContexto"
                            Background="#F5F7F4"
                            BorderBrush="#E2E7E2" BorderThickness="1"
                            CornerRadius="8" Height="52"
                            Padding="4,3,8,3" Margin="0,0,6,8">
                        <Grid ColumnDefinitions="*,Auto,Auto">
                            <ScrollViewer Grid.Column="0"
                                          HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="Disabled"
                                          VerticalAlignment="Center">
                                <StackPanel Name="EntradasHost" Orientation="Horizontal" Spacing="4"/>
                            </ScrollViewer>
                            <TextBlock Grid.Column="1" Name="SubtituloText"
                                       Text="Resumen"
                                       Foreground="#101612"
                                       FontSize="13" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis"
                                       MaxWidth="300"
                                       VerticalAlignment="Center"
                                       Margin="10,0,10,0"/>
                            <StackPanel Grid.Column="2" Name="ContextoPills"
                                        Orientation="Horizontal" Spacing="8"
                                        VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                    <Grid>
                        <ScrollViewer Name="TabScroll"
                                      HorizontalScrollBarVisibility="Auto"
                                      VerticalScrollBarVisibility="Auto">
                            <StackPanel Name="TabHost" Spacing="10" Margin="0,0,6,0"/>
                        </ScrollViewer>
                        <Panel Name="HtmlHost" IsVisible="False" Margin="0,0,6,0"/>
                        <Panel Name="ModuloNativoHost" IsVisible="False" Margin="0,0,6,0"/>
                    </Grid>
                </DockPanel>
            </DockPanel>
        </Border>
    </Panel>
</UserControl>
