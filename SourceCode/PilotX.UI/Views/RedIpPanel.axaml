<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="PilotX.Desktop.Views.RedIpPanel">
    <!--
        RedIpPanel - configuracion de IP (DHCP / fija) por adaptador (WiFi y
        Ethernet). PilotX corre limitado: el cambio real lo aplica el helper
        SYSTEM (NetApplyWatcher) via RedIpService. Las tarjetas por adaptador
        se generan en code-behind.
    -->
    <ThemeVariantScope RequestedThemeVariant="Light">
        <Border Name="Card"
                Background="{StaticResource PilotXPanelCard}"
                BorderBrush="{StaticResource PilotXPanelBorderHigh}"
                BorderThickness="1"
                CornerRadius="14"
                ClipToBounds="True"
                BoxShadow="0 8 26 0 #33101612"
                MaxWidth="840" MaxHeight="620"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                Margin="16,8">
            <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto">
                <StackPanel Name="ContenidoRaiz" Margin="24,20,24,24" Spacing="14">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Name="HeaderTitulo" Grid.Column="0" Spacing="2">
                            <TextBlock Text="Red - IP"
                                       Foreground="{StaticResource PilotXPanelText}"
                                       FontSize="22" FontWeight="SemiBold"/>
                            <TextBlock Text="DHCP o IP fija por adaptador (WiFi y Ethernet)"
                                       Foreground="{StaticResource PilotXPanelTextDim}"
                                       FontSize="12"/>
                        </StackPanel>
                        <Button Grid.Column="1" Content="✕ Cerrar"
                                Click="OnCerrarClick"
                                VerticalAlignment="Top"
                                Background="#E7ECE7" Foreground="#1E241E"
                                BorderThickness="0" CornerRadius="8"
                                Padding="16,10,16,10" FontSize="14" FontWeight="SemiBold"/>
                    </Grid>

                    <StackPanel Name="Adaptadores" Spacing="14"/>

                    <TextBlock Name="StatusGlobal"
                               Text="Cargando adaptadores..."
                               Foreground="{StaticResource PilotXPanelTextDim}"
                               FontSize="12" MinHeight="16" TextWrapping="Wrap"/>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </ThemeVariantScope>
</UserControl>
