<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:PilotX.Desktop.Views"
             x:Class="PilotX.Desktop.Views.GraficoQuantiXPanel">
    <!--
        GraficoQuantiXPanel — el gráfico para calibrar el PID de los motores.

        Contesta una sola pregunta, la que se hace en el lote: si la velocidad
        del MOTOR está planchada y las rpm reales oscilan alrededor del target,
        hay que corregir el PID. Si en cambio la carga está clavada en 100%, el
        motor no puede seguir al target y no hay Kp que lo arregle — eso es
        techo mecánico.

        Por eso la serie de velocidad es la del MOTOR y no la del tractor: en
        curva no son la misma (MotorSpeedKmh), y mirando solo la del GPS se le
        echa la culpa al PID de un cambio de target que fue legítimo.

        Datos: GET /api/quantix/graph-pid?uid=&m= cada 200 ms, del buffer en
        memoria del QxPidRecorder (lo mismo que se está escribiendo al CSV).
        Ventana de 300 muestras = 60 s a 5 Hz.
    -->
    <ThemeVariantScope RequestedThemeVariant="Light">
        <Border Name="Card"
                Background="{StaticResource PilotXPanelCard}"
                BorderBrush="{StaticResource PilotXPanelBorderHigh}"
                BorderThickness="1"
                CornerRadius="14"
                ClipToBounds="True"
                BoxShadow="0 8 26 0 #33101612"
                MaxWidth="720" MaxHeight="560"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                Margin="16,8">

            <Grid Name="ContenidoRaiz" Margin="24,20,24,24"
                  RowDefinitions="Auto,Auto,*,Auto,Auto">

                <!-- ============ Header ============ -->
                <Grid Grid.Row="0" Name="DragHandle" Background="Transparent"
                      ColumnDefinitions="*,Auto,Auto" Margin="0,0,0,16">
                    <StackPanel Grid.Column="0" Name="HeaderTitulo" Spacing="2">
                        <TextBlock Text="Gráfico de PID · QuantiX"
                                   Foreground="{StaticResource PilotXPanelText}"
                                   FontSize="22" FontWeight="SemiBold"/>
                        <TextBlock Text="rpm real contra pedida · velocidad del motor · para calibrar"
                                   Foreground="{StaticResource PilotXPanelTextDim}"
                                   FontSize="12"/>
                    </StackPanel>

                    <Border Grid.Column="1" Name="HeaderPill"
                            Background="{StaticResource PilotXPanelSurface2}"
                            BorderBrush="{StaticResource PilotXPanelBorderHigh}"
                            BorderThickness="1"
                            CornerRadius="999"
                            Padding="14,6,14,6"
                            Margin="0,0,8,0"
                            VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Ellipse Width="8" Height="8"
                                     Fill="{StaticResource PilotXPanelIdle}"
                                     VerticalAlignment="Center"/>
                            <TextBlock Name="StatusText" Text="—"
                                       Foreground="{StaticResource PilotXPanelTextDim}"
                                       FontSize="13"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <Button Grid.Column="2" Name="BtnCerrar" Content="✕"
                            Click="OnCerrarClick"
                            ToolTip.Tip="Cerrar"
                            Background="{StaticResource PilotXPanelSurface2}"
                            Foreground="{StaticResource PilotXPanelText}"
                            BorderBrush="{StaticResource PilotXPanelBorderHigh}"
                            BorderThickness="1"
                            CornerRadius="8" Width="48" Height="48"
                            FontSize="15"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"
                            VerticalAlignment="Center"/>
                </Grid>

                <!-- ============ Lecturas ============ -->
                <Grid Grid.Row="1" ColumnDefinitions="Auto,Auto,Auto,*" Margin="0,0,0,16">
                    <Border Grid.Column="0"
                            Background="{StaticResource PilotXPanelSurface}"
                            BorderBrush="{StaticResource PilotXPanelBorderHigh}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="12,9,20,9"
                            MinWidth="150"
                            Margin="0,0,16,0">
                        <StackPanel Spacing="2">
                            <TextBlock Text="RPM real"
                                       Foreground="{StaticResource PilotXPanelTextDim}"
                                       FontSize="12"/>
                            <TextBlock Name="ValRpm" Text="—"
                                       Foreground="{StaticResource PilotXPanelAccentText}"
                                       FontFamily="Consolas, Courier New, monospace"
                                       FontSize="38" FontWeight="Bold" LineHeight="42"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1"
                            Background="{StaticResource PilotXPanelSurface}"
                            BorderBrush="{StaticResource PilotXPanelBorderHigh}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="12,9,20,9"
                            MinWidth="150"
                            Margin="0,0,16,0">
                        <StackPanel Spacing="2">
                            <TextBlock Text="RPM pedida"
                                       Foreground="{StaticResource PilotXPanelTextDim}"
                                       FontSize="12"/>
                            <TextBlock Name="ValTarget" Text="—"
                                       Foreground="{StaticResource PilotXPanelTextMid}"
                                       FontFamily="Consolas, Courier New, monospace"
                                       FontSize="38" FontWeight="Bold" LineHeight="42"/>
                        </StackPanel>
                    </Border>

                    <!-- Carga: el dato que separa "el PID oscila" de "el motor
                         no da más". Se pone en rojo al llegar al techo. -->
                    <Border Grid.Column="2"
                            Background="{StaticResource PilotXPanelSurface}"
                            BorderBrush="{StaticResource PilotXPanelBorderHigh}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="12,9,20,9"
                            MinWidth="150">
                        <StackPanel Spacing="2">
                            <TextBlock Text="Carga del motor"
                                       Foreground="{StaticResource PilotXPanelTextDim}"
                                       FontSize="12"/>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Name="ValCarga" Text="—"
                                           Foreground="{StaticResource PilotXPanelText}"
                                           FontFamily="Consolas, Courier New, monospace"
                                           FontSize="38" FontWeight="Bold" LineHeight="42"/>
                                <TextBlock Text="%"
                                           Foreground="{StaticResource PilotXPanelTextDim}"
                                           FontFamily="Consolas, Courier New, monospace"
                                           FontSize="22" FontWeight="Bold"
                                           VerticalAlignment="Bottom" Margin="2,0,0,6"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- ============ Área de dibujo ============ -->
                <Border Grid.Row="2"
                        Background="{StaticResource PilotXPanelSurface}"
                        BorderBrush="{StaticResource PilotXPanelBorderHigh}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="12"
                        MinHeight="200">
                    <Grid>
                        <v:GraficoLineal Name="Lienzo"/>
                        <TextBlock Name="AxisMax" Text="—"
                                   Foreground="{StaticResource PilotXPanelTextDim}"
                                   FontFamily="Consolas, Courier New, monospace"
                                   FontSize="11"
                                   HorizontalAlignment="Right" VerticalAlignment="Top"
                                   Margin="0,0,4,0"/>
                        <TextBlock Name="AxisMin" Text="0"
                                   Foreground="{StaticResource PilotXPanelTextDim}"
                                   FontFamily="Consolas, Courier New, monospace"
                                   FontSize="11"
                                   HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                   Margin="0,0,4,0"/>
                        <TextBlock Name="Vacio"
                                   Text="Sin nodos QuantiX en la LAN"
                                   Foreground="{StaticResource PilotXPanelTextDim}"
                                   FontSize="14"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- ============ Leyenda ============ -->
                <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="20" Margin="0,12,0,0">
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <Border Width="14" Height="3" CornerRadius="2"
                                Background="{StaticResource PilotXPanelAccent}"
                                VerticalAlignment="Center"/>
                        <TextBlock Text="RPM real"
                                   Foreground="{StaticResource PilotXPanelTextMid}"
                                   FontSize="12" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <Border Width="14" Height="3" CornerRadius="2"
                                Background="{StaticResource PilotXPanelTextMid}"
                                VerticalAlignment="Center"/>
                        <TextBlock Text="RPM pedida"
                                   Foreground="{StaticResource PilotXPanelTextMid}"
                                   FontSize="12" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <Border Width="14" Height="3" CornerRadius="2"
                                Background="#3D87C6"
                                VerticalAlignment="Center"/>
                        <TextBlock Text="Velocidad del motor (km/h ×10)"
                                   Foreground="{StaticResource PilotXPanelTextMid}"
                                   FontSize="12" VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>

                <!-- ============ Controles ============ -->
                <Grid Grid.Row="4" Name="FilaControles"
                      ColumnDefinitions="Auto,*,Auto" Margin="0,16,0,0">
                    <ComboBox Grid.Column="0" Name="SelectorMotor"
                              MinWidth="260" MinHeight="44" FontSize="14"
                              SelectionChanged="OnMotorCambiado"
                              PlaceholderText="Motor"
                              Background="{StaticResource PilotXPanelSurface2}"
                              Foreground="{StaticResource PilotXPanelText}"
                              BorderBrush="{StaticResource PilotXPanelBorderHigh}"
                              BorderThickness="1" CornerRadius="8"
                              ToolTip.Tip="Qué motor se está mirando"/>

                    <!-- La marca queda en el CSV de los 14 motores a la vez, en
                         el mismo instante: así se alinea "acá toqué Kp" con lo
                         que hicieron todos. -->
                    <Button Grid.Column="2" Name="BtnMarca" Content="Marcar cambio"
                            Click="OnMarcarClick"
                            Background="{StaticResource PilotXPanelSurface2}"
                            Foreground="{StaticResource PilotXPanelText}"
                            BorderBrush="{StaticResource PilotXPanelBorderHigh}"
                            BorderThickness="1" CornerRadius="8"
                            Padding="16,0" MinHeight="44" FontSize="14"
                            HorizontalContentAlignment="Center"
                            ToolTip.Tip="Deja una marca en el registro de los 14 motores, para saber después en qué momento se tocó el PID"/>
                </Grid>

            </Grid>
        </Border>
    </ThemeVariantScope>
</UserControl>
