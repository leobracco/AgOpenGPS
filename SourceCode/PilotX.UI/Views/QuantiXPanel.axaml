<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="PilotX.Desktop.Views.QuantiXPanel">
    <!--
        QuantiXPanel - reemplazo nativo (Monitor live-only) de pages/quantix.html.

        Cabin-critical: ver dosis real vs objetivo + PWM + estado PID por motor
        de cada nodo QuantiX que este publicando telemetria. Se actualiza a 2Hz
        contra /api/quantix/live mientras esta abierto.

        Las otras tabs (Siembra, Motores, Shape, PID live, Calibracion,
        Prueba) YA son nativas desde 2026-08-15: el boton "Configurar" abre
        QuantiXEditorPanel, no el WebView. pages/quantix.html queda intacta
        para la PWA del celular.
    -->
    <!--
        Card clara flotante con el mapa VIVO detras (misma receta que
        ConfigPanel / Hub): antes este panel se pintaba a pantalla completa
        con la paleta oscura y el mapa apagado — "una ventana negra gigante"
        (reporte 2026-08-16). El mapa nunca se apaga ni se tapa del todo.
    -->
    <ThemeVariantScope RequestedThemeVariant="Light">
        <Border Background="{StaticResource PilotXPanelCard}"
                BorderBrush="{StaticResource PilotXPanelBorderHigh}"
                BorderThickness="1"
                CornerRadius="14"
                ClipToBounds="True"
                BoxShadow="0 8 26 0 #33101612"
                MaxWidth="960" MaxHeight="660"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                Margin="16,8">
            <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="24,20,24,24" Spacing="14">

                    <!-- ============ Header ============ -->
                    <Grid ColumnDefinitions="*,Auto,Auto">
                        <StackPanel Grid.Column="0" Spacing="2">
                            <TextBlock Text="QuantiX"
                                       Foreground="{StaticResource PilotXPanelText}"
                                       FontSize="22" FontWeight="SemiBold"/>
                            <TextBlock Text="Control PID - 2 motores por nodo"
                                       Foreground="{StaticResource PilotXPanelTextDim}"
                                       FontSize="12"/>
                        </StackPanel>

                        <!-- Pill: cuantos nodos esta viendo -->
                        <Border Grid.Column="1"
                                Background="{StaticResource PilotXPanelSurface2}"
                                BorderBrush="{StaticResource PilotXPanelBorderHigh}"
                                BorderThickness="1"
                                CornerRadius="999"
                                Padding="14,6,14,6"
                                Margin="0,0,8,0"
                                VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <Ellipse Name="NodosDot"
                                         Width="10" Height="10"
                                         Fill="{StaticResource PilotXPanelTextDim}"
                                         VerticalAlignment="Center"/>
                                <TextBlock Name="NodosText"
                                           Text="-- nodos"
                                           Foreground="{StaticResource PilotXPanelTextMid}"
                                           FontSize="13"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <Button Grid.Column="2"
                                Name="BtnConfigurar"
                                Content="Configurar"
                                Click="OnConfigurarClick"
                                Background="{StaticResource PilotXPanelSurface2}"
                                Foreground="{StaticResource PilotXPanelText}"
                                BorderBrush="{StaticResource PilotXPanelBorderHigh}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="14,6,14,6"
                                VerticalAlignment="Center"
                                ToolTip.Tip="Abre Siembra / Motores / Shape / PID / Calibracion / Prueba"/>
                    </Grid>

                    <!-- ============ Lista de nodos (live) ============ -->
                    <!--
                        Cada nodo es una seccion con N motor-cards en horizontal.
                        Construido dinamicamente desde codigo en cada tick (2Hz).
                    -->
                    <StackPanel Name="NodosHost" Spacing="14"/>

                    <TextBlock Name="EmptyHint"
                               Text="No se ven nodos QuantiX en la LAN. Verifica que el broker MQTT (CoreX/AgIO) este corriendo y los ESP32 conectados."
                               Foreground="{StaticResource PilotXPanelTextDim}"
                               FontSize="12"
                               TextWrapping="Wrap"
                               IsVisible="True"/>

                    <TextBlock Text="El reparto de surcos, la config de motores, el shape de dosis, el tuning PID, la calibracion y las pruebas estan en el boton Configurar."
                               Foreground="{StaticResource PilotXPanelTextDim}"
                               FontSize="11"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </ThemeVariantScope>
</UserControl>
