<Project Sdk="Microsoft.NET.Sdk">

  <!--
    PilotX.GuidanceEngine - bloque 14 (proceso único). El .exe de consola:
    entry point (Program.cs) + el lado "CoreX" (CoreXEngineHost.cs,
    Net9SerialPortService.cs, con su PackageReference a System.IO.Ports).

    El loop de guiado en sí (GuidanceEngineHost*.cs — orquesta los mismos
    CPositionUpdater/CHeadingUpdater/CAutoSteerUpdater/CYouTurnUpdater/
    CSectionCalculator/CSettingsSender de AgOpenGPS.Core, bloque 9) vive
    separado en PilotX.GuidanceEngine.Core: PilotX.Android lo referencia
    directo para los servicios reales de guiado/lotes del Hub, sin poder
    arrastrar System.IO.Ports (net9.0-android no lo restaura, ver el
    comentario de cabecera de PilotX.GuidanceEngine.Core.csproj).

    Deliberadamente net9.0 (NO -windows): nada acá debería necesitar
    Windows Forms ni OpenGL — si algún día no compila en net9.0 puro es
    señal de que algo no está realmente desacoplado.

    Habla con CoreX por el mismo protocolo UDP loopback que usa FormGPS
    (recibe PGN de posición en :15555, contesta PGN a CoreX en
    127.255.255.255:17777) — así se puede correr contra un CoreX/ModSim
    real sin tocarlos.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>disable</Nullable>
    <RootNamespace>PilotX.GuidanceEngine</RootNamespace>
    <AssemblyName>PilotX.GuidanceEngine</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\PilotX.GuidanceEngine.Core\PilotX.GuidanceEngine.Core.csproj" />
    <ProjectReference Include="..\AgLibrary\AgLibrary.csproj" />
    <!-- MqttBrokerService/UdpBridgeService/NtripClientService/PgnFrameParser/
         ISerialPortService (bloque 8/14) — ya portables (netstandard2.0). -->
    <ProjectReference Include="..\AgroParallel\Core\AgroParallel.Services\AgroParallel.Services.csproj" />
    <!-- AgpWebHost + controllers (netstandard2.0, EmbedIO): con el flag webhost
         el engine headless sirve la API /api/aog igual que FormGPS, para que
         PilotX.Desktop renderice el mapa contra el motor sin WinForms. -->
    <ProjectReference Include="..\AgroParallel\Web\AgroParallel.WebHost\AgroParallel.WebHost.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- System.IO.Ports no viene con el SDK base en net9.0 "puro" (sin
         -windows): CoreXEngineHost lo necesita para los 6 puertos serie
         reales (GPS/GPS2/RTCM/IMU/Steer/Machine). -->
    <PackageReference Include="System.IO.Ports" Version="9.0.0" />
    <!-- EngineSistemaService: brillo de pantalla vía WMI (root\WMI,
         WmiMonitorBrightness) — fallback si el monitor no soporta DDC/CI. -->
    <PackageReference Include="System.Management" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- CNmeaParser/INmeaParserHost (AgIO) ya son 100% portables (sin
         WinForms, ver su propio comentario de cabecera) pero viven
         físicamente en el proyecto AgIO (net48, WinForms completo).
         Se linkean por archivo en vez de agregar ProjectReference a todo
         AgIO.csproj — evita arrastrar OpenTK/WinForms a este proceso. -->
    <Compile Include="..\AgIO\Source\Classes\NmeaParser.cs" Link="AgIO\NmeaParser.cs" />
    <Compile Include="..\AgIO\Source\Classes\INmeaParserHost.cs" Link="AgIO\INmeaParserHost.cs" />
    <Compile Include="..\AgIO\Source\Classes\CGLM.cs" Link="AgIO\CGLM.cs" />
    <!-- Panel CoreX integrado (:5181): el snapshot y su controller de status
         son puros (no tocan FormLoop), se comparten con CoreX.exe para que
         /api/corex/status sirva el MISMO wire en los dos modos. -->
    <Compile Include="..\AgIO\Source\Classes\CoreXState.cs" Link="AgIO\CoreXState.cs" />
    <Compile Include="..\AgIO\Source\Web\CoreXStatusController.cs" Link="AgIO\CoreXStatusController.cs" />
    <!-- Mapeo TramSnapshot->DTO: MISMO archivo que compila AgOpenGPS.csproj,
         para que las dos pantallas de tramlines dibujen igual. -->
    <Compile Include="..\AgroParallel\Adapters\TramLineMapper.cs" Link="AgroParallel\TramLineMapper.cs" />
    <!-- Capa de prescripcion (.shp): geometria + dosis por posicion. La usa
         el motor para QuantiX/FlowX y para servir /api/aog/shape al mapa. -->
    <Compile Include="..\AgroParallel\Adapters\ShapefileLayer.cs" Link="AgroParallel\ShapefileLayer.cs" />
    <Compile Include="..\GPS\AgroParallel\Common\EarClipper.cs" Link="AgroParallel\EarClipper.cs" />
    <!-- Config de dirección (ISteerConfigService): mapeo settings↔DTO + PGN
         252/251. Mismo archivo que compila AgOpenGPS.csproj (FormGPS) para no
         duplicar el port del FormSteer nativo en dos lados. -->
    <Compile Include="..\AgroParallel\Adapters\SteerConfigService.cs" Link="AgroParallel\SteerConfigService.cs" />
  </ItemGroup>

</Project>
