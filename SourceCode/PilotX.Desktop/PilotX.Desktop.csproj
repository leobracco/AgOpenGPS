<Project Sdk="Microsoft.NET.Sdk">

  <!--
    PilotX.Desktop — HEAD Windows del shell Avalonia de PilotX.

    Tras L1 del port Android (ver COORDINACION-SESIONES.md), este proyecto es
    solo el "head" de escritorio: aporta lo específico de Windows/Desktop y
    referencia la UI compartida (PilotX.UI). Contiene:
      · Program.cs            — entrypoint + parseo de args + AppBuilder desktop
      · DesktopWebViewHost.cs — implementación de IWebViewHost con WebView.Avalonia
      · app.manifest

    Toda la UI (App, MainWindow, Views, Services, mapa GL) vive en PilotX.UI.
    El head Android (PilotX.Android.App, carril Santiago) referencia la MISMA
    PilotX.UI y aporta su propio host de WebView + AppBuilder Android.

    Build:  dotnet build SourceCode/PilotX.Desktop/PilotX.Desktop.csproj -c Debug
    Run:    dotnet run (project SourceCode/PilotX.Desktop, sin rebuild)
  -->

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- net9.0 puro (2026-08-14): el head también publica para linux-x64.
         Lo Windows-only (teclado SendInput, winmm, RustDesk) queda detrás de
         OperatingSystem.IsWindows(); WebView.Avalonia trae backend por OS. -->
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Icono de marca PilotX (Diseño/PilotX/PilotX.png, generado
         multi-resolución 16→256 para que se vea bien en barra de tareas,
         alt-tab y acceso directo). -->
    <ApplicationIcon>PilotX.ico</ApplicationIcon>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <RootNamespace>PilotX.Desktop</RootNamespace>
    <AssemblyName>PilotX.Desktop</AssemblyName>
    <NoWarn>$(NoWarn);CS8618;CS8600;CS8601;CS8602;IDE0055</NoWarn>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <!-- ==========================================================
         Tuning de runtime para tractor (objetivo bajo consumo)
         ========================================================== -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
    <TieredCompilation>true</TieredCompilation>
    <TieredCompilationQuickJit>true</TieredCompilationQuickJit>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <!-- Release: SIN ReadyToRun. NO tocar sin leer esto.
       Historia (2026-09-05): este head se publicaba con ReadyToRun +
       Composite. El composite mete el codigo nativo de TODOS los ensamblados
       en un unico PilotX.Desktop.r2r.dll de 90 MB, y eso hacia que el parche
       minimo de cualquier fix pesara ~90 MB.
       Al apagar SOLO el composite (1.0.48) quedo ReadyToRun=true sin
       composite, y esa combinacion produce un binario que MUERE AL ARRANCAR
       con FailFast (0xC0000602) y sin ningun mensaje. Se comprobo comparando
       contra la 1.0.47 limpia en la misma PC: 1.0.47 abre, 1.0.48 muere.
       Con ReadyToRun apagado del todo arranca bien y ademas cada ensamblado
       queda chico, que era el objetivo. Costo medido del arranque en frio:
       3789 ms contra 3042 ms del composite. 750 ms mas, aceptable.
       OJO: build.ps1 pasa estas propiedades por linea de comandos y PISA lo
       que diga este archivo. Si cambias algo aca, cambialo tambien alla. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <PublishReadyToRun>false</PublishReadyToRun>
    <PublishReadyToRunComposite>false</PublishReadyToRunComposite>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>

  <ItemGroup>
    <!-- Plataforma Desktop de Avalonia (X11/Win32) — específica del head. -->
    <PackageReference Include="Avalonia.Desktop" Version="11.2.3" />
    <PackageReference Include="Avalonia.Diagnostics" Version="11.2.3" Condition="'$(Configuration)' == 'Debug'" />

    <!-- WebView.Avalonia: PUENTE TEMPORAL, backend Desktop del IWebViewHost.
         Se instancia on-demand al abrir una pantalla no portada, se libera al
         cerrar. NUNCA residente durante el guiado. Cuando todas las pantallas
         estén portadas a nativo, se borra esta referencia + DesktopWebViewHost. -->
    <PackageReference Include="WebView.Avalonia" Version="11.0.0.1" />
    <PackageReference Include="WebView.Avalonia.Desktop" Version="11.0.0.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- UI compartida: App, MainWindow, Views, Services, mapa GL. -->
    <ProjectReference Include="..\PilotX.UI\PilotX.UI.csproj" />
  </ItemGroup>

</Project>
