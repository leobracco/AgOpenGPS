<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PilotX.Cockpit.Bars.ViewModels"
             xmlns:views="using:PilotX.Cockpit.Bars.Views"
             x:Class="PilotX.Cockpit.Bars.Views.BarraAbajo"
             x:DataType="vm:BarraAbajoViewModel">
  <UserControl.Resources>
    <views:AssetImageConverter x:Key="Asset"/>
    <views:SkipsIndexConverter x:Key="SkipsIndex"/>
  </UserControl.Resources>

  <Border Background="#F5F7F4" BorderBrush="#C5CFC5" BorderThickness="0,1,0,0" Padding="3">
    <!-- orden visual izq->der; a la derecha "elegir guía" (como el nativo RTL) -->
    <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center">
      <ComboBox x:Name="SkipsCombo" IsVisible="{Binding SkipsVisible}" VerticalAlignment="Center"
                FontSize="14" MinWidth="46"
                SelectedIndex="{Binding SkipsValue, Converter={StaticResource SkipsIndex}, Mode=OneWay}"
                SelectionChanged="OnSkipsSelectionChanged">
        <ComboBoxItem Content="1"/><ComboBoxItem Content="2"/><ComboBoxItem Content="3"/>
        <ComboBoxItem Content="4"/><ComboBoxItem Content="5"/><ComboBoxItem Content="6"/>
        <ComboBoxItem Content="7"/><ComboBoxItem Content="8"/><ComboBoxItem Content="9"/>
        <ComboBoxItem Content="10"/>
      </ComboBox>
      <Button IsVisible="{Binding YouSkipVisible}" Command="{Binding SendCommand}" CommandParameter="uturn_skips">
        <Image Source="{Binding YouSkipImg, Converter={StaticResource Asset}}"/>
      </Button>
      <Button Command="{Binding SendCommand}" CommandParameter="mapeo_color">
        <Image Source="/Assets/barra-abajo/SectionMapping.png"/>
      </Button>
      <Button Command="{Binding SendCommand}" CommandParameter="reset_herramienta">
        <Image Source="/Assets/barra-abajo/ResetTool.png"/>
      </Button>
      <Button IsVisible="{Binding TramVisible}" Command="{Binding SendCommand}" CommandParameter="tram_vista">
        <Image Source="{Binding TramImg, Converter={StaticResource Asset}}"/>
      </Button>
      <Button IsVisible="{Binding HydVisible}" IsEnabled="{Binding HydEnabled}" Command="{Binding SendCommand}" CommandParameter="hidraulico">
        <Image Source="{Binding HydImg, Converter={StaticResource Asset}}"/>
      </Button>
      <Button IsVisible="{Binding HeadlandVisible}" Command="{Binding SendCommand}" CommandParameter="cabecera_secciones">
        <Image Source="{Binding HdlSecImg, Converter={StaticResource Asset}}"/>
      </Button>
      <Button IsVisible="{Binding HeadlandVisible}" Command="{Binding SendCommand}" CommandParameter="cabecera_onoff">
        <Image Source="{Binding HeadlandImg, Converter={StaticResource Asset}}"/>
      </Button>
      <Button Command="{Binding SendCommand}" CommandParameter="bandera">
        <Image Source="{Binding FlagImg, Converter={StaticResource Asset}}"/>
      </Button>
      <Button IsVisible="{Binding NudgeVisible}" Command="{Binding SendCommand}" CommandParameter="nudge_left">
        <Image Source="/Assets/barra-abajo/SnapLeft.png"/>
      </Button>
      <Button IsVisible="{Binding NudgeVisible}" Command="{Binding SendCommand}" CommandParameter="nudge_right">
        <Image Source="/Assets/barra-abajo/SnapRight.png"/>
      </Button>
      <Button IsVisible="{Binding NudgeVisible}" Command="{Binding SendCommand}" CommandParameter="center">
        <Image Source="/Assets/barra-abajo/SnapToPivot.png"/>
      </Button>
      <Button Command="{Binding SendCommand}" CommandParameter="pick">
        <Image Source="/Assets/barra-abajo/TrackOn.png"/>
      </Button>
    </StackPanel>
  </Border>
</UserControl>
