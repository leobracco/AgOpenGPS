<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PilotX.Cockpit.Bars.ViewModels"
             xmlns:views="using:PilotX.Cockpit.Bars.Views"
             x:Class="PilotX.Cockpit.Bars.Views.BarraDerecha"
             x:DataType="vm:BarraDerechaViewModel">
  <UserControl.Resources>
    <views:AssetImageConverter x:Key="Asset"/>
  </UserControl.Resources>

  <Border Background="#F5F7F4" BorderBrush="#C5CFC5" BorderThickness="1,0,0,0" Padding="3">
    <!-- orden visual arriba->abajo (numCu arriba, Piloto abajo, como el nativo) -->
    <StackPanel Orientation="Vertical" Spacing="3">
      <TextBlock Text="{Binding NumCuText}" IsVisible="{Binding NumCuVisible}"
                 FontSize="14" FontWeight="Bold" Foreground="#101612"
                 HorizontalAlignment="Center" Margin="0,1"/>
      <Button IsVisible="{Binding ContourLockVisible}" Command="{Binding SendCommand}" CommandParameter="contour_lock">
        <Image Source="{Binding ContourLockImg, Converter={StaticResource Asset}}"/>
      </Button>
      <Button Command="{Binding SendCommand}" CommandParameter="contour">
        <Image Source="{Binding ContourImg, Converter={StaticResource Asset}}"/>
      </Button>
      <Button IsVisible="{Binding TrackNavVisible}" Command="{Binding SendCommand}" CommandParameter="track_next">
        <Image Source="/Assets/barra-derecha/ABLineCycle.png"/>
      </Button>
      <Button IsVisible="{Binding TrackNavVisible}" Command="{Binding SendCommand}" CommandParameter="track_prev">
        <Image Source="/Assets/barra-derecha/ABLineCycleBk.png"/>
      </Button>
      <Button IsVisible="{Binding TrackNavVisible}" Command="{Binding SendCommand}" CommandParameter="autotrack">
        <Image Source="{Binding AutoTrackImg, Converter={StaticResource Asset}}"/>
      </Button>
      <Button IsVisible="{Binding IsobusVisible}" Command="{Binding SendCommand}" CommandParameter="isobus">
        <Image Source="{Binding IsobusImg, Converter={StaticResource Asset}}"/>
      </Button>
      <Button Command="{Binding SendCommand}" CommandParameter="sec_manual">
        <Image Source="{Binding SecManualImg, Converter={StaticResource Asset}}"/>
      </Button>
      <Button Command="{Binding SendCommand}" CommandParameter="sec_auto">
        <Image Source="{Binding SecAutoImg, Converter={StaticResource Asset}}"/>
      </Button>
      <Button IsVisible="{Binding UturnVisible}" Command="{Binding SendCommand}" CommandParameter="uturn">
        <Image Source="{Binding UturnImg, Converter={StaticResource Asset}}"/>
      </Button>

      <!-- Giro MANUAL y salto de guía. En AOG 6.8.5 esto no tiene botón: son
           zonas invisibles del mapa que hay que acertar a ciegas mientras se
           maneja. Acá se muestran, que es de lo que se trata una cabina.
           Solo aparecen con el giro automático activo: sin eso no hay a dónde
           girar y serían dos botones muertos ocupando barra. -->
      <StackPanel Orientation="Horizontal" Spacing="2" HorizontalAlignment="Center"
                  IsVisible="{Binding GiroManualVisible}">
        <Button Command="{Binding SendCommand}" CommandParameter="uturn_manual_izq"
                Width="24" Padding="0" ToolTip.Tip="Girar ahora a la izquierda">
          <TextBlock Text="↰" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center"/>
        </Button>
        <Button Command="{Binding SendCommand}" CommandParameter="uturn_manual_der"
                Width="24" Padding="0" ToolTip.Tip="Girar ahora a la derecha">
          <TextBlock Text="↱" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center"/>
        </Button>
      </StackPanel>

      <!-- SALTEAR GUÍA: te corrés a la guía de al lado y seguís PARA ADELANTE,
           sin dar la vuelta. Es lo que se usa para esquivar un pozo o retomar
           donde quedaste. No depende del giro automático —por eso no comparte
           visibilidad con los botones de arriba—: alcanza con tener una guía. -->
      <StackPanel Orientation="Horizontal" Spacing="2" HorizontalAlignment="Center"
                  IsVisible="{Binding LateralVisible}">
        <Button Command="{Binding SendCommand}" CommandParameter="lateral_izq"
                Width="24" Padding="0" ToolTip.Tip="Saltear a la guía de la izquierda">
          <TextBlock Text="⇤" FontSize="15" FontWeight="Bold" HorizontalAlignment="Center"/>
        </Button>
        <Button Command="{Binding SendCommand}" CommandParameter="lateral_der"
                Width="24" Padding="0" ToolTip.Tip="Saltear a la guía de la derecha">
          <TextBlock Text="⇥" FontSize="15" FontWeight="Bold" HorizontalAlignment="Center"/>
        </Button>
      </StackPanel>

      <!-- Cuántas guías saltea EL GIRO. Es un número que se elige, no un modo
           que cicla: "salteo 2" es una decisión concreta y buscarla ciclando un
           botón mientras se llega a la cabecera no sirve. -->
      <StackPanel IsVisible="{Binding GiroManualVisible}" HorizontalAlignment="Center">
        <TextBlock Text="saltea" FontSize="9" Foreground="#535E54"
                   HorizontalAlignment="Center"/>
        <ComboBox ItemsSource="{Binding SaltosPosibles}"
                  SelectedItem="{Binding SaltoDelGiro}"
                  Width="46" MinHeight="28" Padding="4,0" FontSize="13"
                  HorizontalAlignment="Center"
                  ToolTip.Tip="Guías que saltea el giro en cabecera"/>
      </StackPanel>
      <Button IsEnabled="{Binding PilotoEnabled}" Command="{Binding SendCommand}" CommandParameter="autosteer">
        <Image Source="{Binding PilotoImg, Converter={StaticResource Asset}}"/>
      </Button>
    </StackPanel>
  </Border>
</UserControl>
