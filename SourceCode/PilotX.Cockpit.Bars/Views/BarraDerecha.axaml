<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PilotX.Cockpit.Bars.ViewModels"
             xmlns:views="using:PilotX.Cockpit.Bars.Views"
             x:Class="PilotX.Cockpit.Bars.Views.BarraDerecha"
             x:DataType="vm:BarraDerechaViewModel">
  <UserControl.Resources>
    <views:AssetImageConverter x:Key="Asset"/>
  </UserControl.Resources>

  <Border Background="#F5F7F4" BorderBrush="#C5CFC5" BorderThickness="1,0,0,0" Padding="3">
    <!-- orden visual arriba->abajo (numCu arriba, Piloto abajo, como el nativo) -->
    <StackPanel Orientation="Vertical" Spacing="3">
      <TextBlock Text="{Binding NumCuText}" IsVisible="{Binding NumCuVisible}"
                 FontSize="14" FontWeight="Bold" Foreground="#101612"
                 HorizontalAlignment="Center" Margin="0,1"/>
      <Button IsVisible="{Binding ContourLockVisible}" Command="{Binding SendCommand}" CommandParameter="contour_lock">
        <Image Source="{Binding ContourLockImg, Converter={StaticResource Asset}}"/>
      </Button>
      <Button Command="{Binding SendCommand}" CommandParameter="contour">
        <Image Source="{Binding ContourImg, Converter={StaticResource Asset}}"/>
      </Button>
      <Button IsVisible="{Binding TrackNavVisible}" Command="{Binding SendCommand}" CommandParameter="track_next">
        <Image Source="/Assets/barra-derecha/ABLineCycle.png"/>
      </Button>
      <Button IsVisible="{Binding TrackNavVisible}" Command="{Binding SendCommand}" CommandParameter="track_prev">
        <Image Source="/Assets/barra-derecha/ABLineCycleBk.png"/>
      </Button>
      <Button IsVisible="{Binding TrackNavVisible}" Command="{Binding SendCommand}" CommandParameter="autotrack">
        <Image Source="{Binding AutoTrackImg, Converter={StaticResource Asset}}"/>
      </Button>
      <Button IsVisible="{Binding IsobusVisible}" Command="{Binding SendCommand}" CommandParameter="isobus">
        <Image Source="{Binding IsobusImg, Converter={StaticResource Asset}}"/>
      </Button>
      <Button Command="{Binding SendCommand}" CommandParameter="sec_manual">
        <Image Source="{Binding SecManualImg, Converter={StaticResource Asset}}"/>
      </Button>
      <Button Command="{Binding SendCommand}" CommandParameter="sec_auto">
        <Image Source="{Binding SecAutoImg, Converter={StaticResource Asset}}"/>
      </Button>
      <Button IsVisible="{Binding UturnVisible}" Command="{Binding SendCommand}" CommandParameter="uturn">
        <Image Source="{Binding UturnImg, Converter={StaticResource Asset}}"/>
      </Button>

      <!-- Bajados de la barra de abajo (pedido usuario 2026-08-04): enderezar
           implemento, bandera y crear guías. Son acciones puntuales, no de la
           pasada, y acá quedan al alcance sin competir con las secciones. -->
      <Button Command="{Binding SendCommand}" CommandParameter="reset_herramienta"
              ToolTip.Tip="Enderezar implemento">
        <Image Source="/Assets/barra-abajo/ResetTool.png"/>
      </Button>
      <Button Command="{Binding SendCommand}" CommandParameter="bandera" ToolTip.Tip="Bandera">
        <Image Source="{Binding FlagImg, Converter={StaticResource Asset}}"/>
      </Button>
      <Button Command="{Binding SendCommand}" CommandParameter="pick" ToolTip.Tip="Guías">
        <Image Source="/Assets/barra-abajo/TrackOn.png"/>
      </Button>

      <!-- Giro manual (↰/↱), salteo de guía y cantidad de guías a saltear
           VIVÍAN acá; se quitaron a pedido del usuario porque ya están todos
           en el cluster del piloto (arriba-centro del mapa, MainWindow:
           PcGiroIzq/PcGiroDer/PcSkipMenos/PcSkipMas). Duplicados en la barra
           solo robaban lugar. Los bindings (GiroManualVisible, LateralVisible,
           SaltosPosibles, SaltoDelGiro) siguen vivos en el ViewModel por si
           alguna vista los quiere. -->
      <Button IsEnabled="{Binding PilotoEnabled}" Command="{Binding SendCommand}" CommandParameter="autosteer">
        <Image Source="{Binding PilotoImg, Converter={StaticResource Asset}}"/>
      </Button>
    </StackPanel>
  </Border>
</UserControl>
