<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PilotX.Cockpit.Bars.ViewModels"
             xmlns:views="using:PilotX.Cockpit.Bars.Views"
             x:Class="PilotX.Cockpit.Bars.Views.BarraDerecha"
             x:DataType="vm:BarraDerechaViewModel">
  <UserControl.Resources>
    <views:AssetImageConverter x:Key="Asset"/>
  </UserControl.Resources>

  <UserControl.Styles>
    <!-- Botón con título: el ícono solo no alcanzaba para saber qué hacía
         cada uno (pedido usuario 2026-08-04). -->
    <Style Selector="TextBlock.cap">
      <Setter Property="FontSize" Value="9"/>
      <Setter Property="Foreground" Value="#535E54"/>
      <Setter Property="HorizontalAlignment" Value="Center"/>
      <Setter Property="TextAlignment" Value="Center"/>
      <Setter Property="Margin" Value="0,1,0,0"/>
    </Style>
    <!-- Estos botones son ÍCONO: sin atenuarlo se ven igual de vivos estando
         deshabilitados y el operario los toca esperando que hagan algo. -->
    <Style Selector="Button:disabled Image">
      <Setter Property="Opacity" Value="0.35"/>
    </Style>
  </UserControl.Styles>

  <Border Background="#F5F7F4" BorderBrush="#C5CFC5" BorderThickness="1,0,0,0" Padding="3">
    <!-- orden visual arriba->abajo (numCu arriba, Piloto abajo, como el nativo) -->
    <StackPanel Orientation="Vertical" Spacing="3">
      <TextBlock Text="{Binding NumCuText}" IsVisible="{Binding NumCuVisible}"
                 FontSize="14" FontWeight="Bold" Foreground="#101612"
                 HorizontalAlignment="Center" Margin="0,1"/>
      <Button IsVisible="{Binding ContourLockVisible}" Command="{Binding SendCommand}" CommandParameter="contour_lock">
        <StackPanel>
          <Image Source="{Binding ContourLockImg, Converter={StaticResource Asset}}"/>
          <TextBlock Classes="cap" Text="Fijar cont."/>
        </StackPanel>
      </Button>
      <Button Command="{Binding SendCommand}" CommandParameter="contour">
        <StackPanel>
          <Image Source="{Binding ContourImg, Converter={StaticResource Asset}}"/>
          <TextBlock Classes="cap" Text="Contorno"/>
        </StackPanel>
      </Button>
      <Button IsVisible="{Binding TrackNavVisible}" Command="{Binding SendCommand}" CommandParameter="track_next">
        <StackPanel>
          <Image Source="/Assets/barra-derecha/ABLineCycle.png"/>
          <TextBlock Classes="cap" Text="Guía sig."/>
        </StackPanel>
      </Button>
      <Button IsVisible="{Binding TrackNavVisible}" Command="{Binding SendCommand}" CommandParameter="track_prev">
        <StackPanel>
          <Image Source="/Assets/barra-derecha/ABLineCycleBk.png"/>
          <TextBlock Classes="cap" Text="Guía ant."/>
        </StackPanel>
      </Button>
      <Button IsVisible="{Binding TrackNavVisible}" Command="{Binding SendCommand}" CommandParameter="autotrack">
        <StackPanel>
          <Image Source="{Binding AutoTrackImg, Converter={StaticResource Asset}}"/>
          <TextBlock Classes="cap" Text="Auto guía"/>
        </StackPanel>
      </Button>
      <Button IsVisible="{Binding IsobusVisible}" Command="{Binding SendCommand}" CommandParameter="isobus">
        <StackPanel>
          <Image Source="{Binding IsobusImg, Converter={StaticResource Asset}}"/>
          <TextBlock Classes="cap" Text="ISOBUS"/>
        </StackPanel>
      </Button>
      <Button Command="{Binding SendCommand}" CommandParameter="sec_manual">
        <StackPanel>
          <Image Source="{Binding SecManualImg, Converter={StaticResource Asset}}"/>
          <TextBlock Classes="cap" Text="Manual"/>
        </StackPanel>
      </Button>
      <Button Command="{Binding SendCommand}" CommandParameter="sec_auto">
        <StackPanel>
          <Image Source="{Binding SecAutoImg, Converter={StaticResource Asset}}"/>
          <TextBlock Classes="cap" Text="Auto"/>
        </StackPanel>
      </Button>
      <Button IsVisible="{Binding UturnVisible}" Command="{Binding SendCommand}" CommandParameter="uturn">
        <StackPanel>
          <Image Source="{Binding UturnImg, Converter={StaticResource Asset}}"/>
          <TextBlock Classes="cap" Text="Giro"/>
        </StackPanel>
      </Button>

      <!-- La corrección lateral (izq/der/centrar) se fue a un overlay
           flotante sobre el mapa, centrado arriba de las secciones: son tres
           botones que se usan juntos y mirando la línea, no la barra.
           Bajados de la barra de abajo (pedido usuario 2026-08-04). Allá
           aparecían y desaparecían según el estado y nunca se sabía qué eran;
           acá van fijos y CON TÍTULO. Deshabilitados cuando no aplican. -->
      <Button IsEnabled="{Binding TramVisible}" Command="{Binding SendCommand}" CommandParameter="tram_vista">
        <StackPanel>
          <Image Source="{Binding TramImg, Converter={StaticResource Asset}}"/>
          <TextBlock Classes="cap" Text="Tram"/>
        </StackPanel>
      </Button>
      <Button IsEnabled="{Binding HydEnabled}" IsVisible="{Binding HydVisible}"
              Command="{Binding SendCommand}" CommandParameter="hidraulico">
        <StackPanel>
          <Image Source="{Binding HydImg, Converter={StaticResource Asset}}"/>
          <TextBlock Classes="cap" Text="Hidráulico"/>
        </StackPanel>
      </Button>

      <!-- Guía de por medio y los dos de corte por cabecera. Estuvieron un rato
           en la barra de arriba pero el usuario los quiso acá, con el resto de
           lo que se toca durante la pasada. Siempre visibles y deshabilitados
           cuando no aplican (sin guía activa / sin cabecera), no ocultos: la
           barra no se mueve sola y se ve qué hay disponible. -->
      <Button IsEnabled="{Binding YouSkipVisible}" Command="{Binding SendCommand}"
              CommandParameter="uturn_skips" ToolTip.Tip="Guía de por medio">
        <StackPanel>
          <Image Source="{Binding YouSkipImg, Converter={StaticResource Asset}}"/>
          <TextBlock Classes="cap" Text="Por medio"/>
        </StackPanel>
      </Button>
      <Button IsEnabled="{Binding HeadlandVisible}" Command="{Binding SendCommand}"
              CommandParameter="cabecera_secciones" ToolTip.Tip="Corte por cabecera: secciones">
        <StackPanel>
          <Image Source="{Binding HdlSecImg, Converter={StaticResource Asset}}"/>
          <TextBlock Classes="cap" Text="Cab. secc."/>
        </StackPanel>
      </Button>
      <Button IsEnabled="{Binding HeadlandVisible}" Command="{Binding SendCommand}"
              CommandParameter="cabecera_onoff" ToolTip.Tip="Corte por cabecera: activar">
        <StackPanel>
          <Image Source="{Binding HeadlandImg, Converter={StaticResource Asset}}"/>
          <TextBlock Classes="cap" Text="Cabecera"/>
        </StackPanel>
      </Button>

      <!-- Bajados de la barra de abajo (pedido usuario 2026-08-04): enderezar
           implemento, bandera y crear guías. Son acciones puntuales, no de la
           pasada, y acá quedan al alcance sin competir con las secciones. -->
      <Button Command="{Binding SendCommand}" CommandParameter="reset_herramienta"
              ToolTip.Tip="Enderezar implemento">
        <StackPanel>
          <Image Source="/Assets/barra-abajo/ResetTool.png"/>
          <TextBlock Classes="cap" Text="Enderezar"/>
        </StackPanel>
      </Button>
      <Button Command="{Binding SendCommand}" CommandParameter="bandera" ToolTip.Tip="Bandera">
        <StackPanel>
          <Image Source="{Binding FlagImg, Converter={StaticResource Asset}}"/>
          <TextBlock Classes="cap" Text="Bandera"/>
        </StackPanel>
      </Button>
      <Button Command="{Binding SendCommand}" CommandParameter="pick" ToolTip.Tip="Guías">
        <StackPanel>
          <Image Source="/Assets/barra-abajo/TrackOn.png"/>
          <TextBlock Classes="cap" Text="Guías"/>
        </StackPanel>
      </Button>

      <!-- Giro manual (↰/↱), salteo de guía y cantidad de guías a saltear
           VIVÍAN acá; se quitaron a pedido del usuario porque ya están todos
           en el cluster del piloto (arriba-centro del mapa, MainWindow:
           PcGiroIzq/PcGiroDer/PcSkipMenos/PcSkipMas). Duplicados en la barra
           solo robaban lugar. Los bindings (GiroManualVisible, LateralVisible,
           SaltosPosibles, SaltoDelGiro) siguen vivos en el ViewModel por si
           alguna vista los quiere. -->
      <Button IsEnabled="{Binding PilotoEnabled}" Command="{Binding SendCommand}" CommandParameter="autosteer">
        <StackPanel>
          <Image Source="{Binding PilotoImg, Converter={StaticResource Asset}}"/>
          <TextBlock Classes="cap" Text="Piloto"/>
        </StackPanel>
      </Button>
    </StackPanel>
  </Border>
</UserControl>
